<% var mod = arac.mod === 'profil' ? 'profil' : 'indir'; %>
<div class="arac" id="arac" data-mod="<%= mod %>" data-format="<%= arac.format || '' %>">
  <form class="arac-form" id="aracForm" action="#" novalidate>
    <label class="gizli-etiket" for="aracGiris"><%= mod === 'profil' ? 'Instagram kullanıcı adı veya profil bağlantısı' : 'Video bağlantısı veya şarkı adı' %></label>
    <div class="arac-giris-kap">
      <svg class="arac-giris-ikon" width="20" height="20" aria-hidden="true"><use href="<%= mod === 'profil' ? '#p-instagram' : '#i-baglanti' %>"/></svg>
      <input class="arac-giris" id="aracGiris" name="q" type="text" inputmode="url" enterkeyhint="go"
             placeholder="<%= arac.placeholder || (mod === 'profil' ? 'kullaniciadi veya instagram.com/kullaniciadi' : 'Bağlantıyı buraya yapıştırın') %>"
             autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="500">
      <button class="arac-yapistir" id="aracYapistir" type="button" aria-label="Panodan yapıştır">
        <svg width="16" height="16" aria-hidden="true"><use href="#i-yapistir"/></svg><span>Yapıştır</span>
      </button>
      <button class="arac-temizle" id="aracTemizle" type="button" aria-label="Temizle" hidden>
        <svg width="16" height="16" aria-hidden="true"><use href="#i-kapat"/></svg>
      </button>
    </div>
    <button class="btn btn-ana arac-gonder" id="aracGonder" type="submit">
      <span class="arac-gonder-metin"><%= mod === 'profil' ? 'Göster' : 'İndir' %></span>
      <svg width="18" height="18" aria-hidden="true"><use href="#i-sag-ok"/></svg>
    </button>
  </form>

  <% if (mod === 'indir') { %>
  <ul class="arac-platformlar" aria-label="Desteklenen platformlar">
    <li><svg width="15" height="15" aria-hidden="true"><use href="#p-youtube"/></svg>YouTube</li>
    <li><svg width="15" height="15" aria-hidden="true"><use href="#p-instagram"/></svg>Instagram</li>
    <li><svg width="15" height="15" aria-hidden="true"><use href="#p-tiktok"/></svg>TikTok</li>
    <li><svg width="15" height="15" aria-hidden="true"><use href="#p-x"/></svg>X</li>
    <li><svg width="15" height="15" aria-hidden="true"><use href="#p-facebook"/></svg>Facebook</li>
    <li class="arac-platform-daha"><a href="/araclar/">+20 platform</a></li>
  </ul>
  <% } else { %>
  <p class="arac-ipucu"><svg width="15" height="15" aria-hidden="true"><use href="#i-kalkan"/></svg>Şifre istemeyiz. Yalnızca herkese açık profil fotoğrafı gösterilir.</p>
  <% } %>

  <div class="arac-mesaj" id="aracMesaj" role="status" aria-live="polite" hidden></div>

  <div class="sonuc" id="sonuc" hidden>
    <button class="metin-btn" id="aramayaDon" type="button" hidden><svg width="16" height="16" aria-hidden="true"><use href="#i-sol-ok"/></svg>Arama sonuçlarına dön</button>
    <div id="aramaSonuclari" class="arama-sonuclari"></div>
    <div id="medya" class="medya" hidden></div>
    <div id="oynatma" class="oynatma" hidden>
      <div class="oynatma-ust">
        <p class="oynatma-baslik">Oynatma listesi</p>
        <button class="metin-btn" id="oynatmaTumu" type="button">Tümünü kaldır</button>
      </div>
      <p class="oynatma-sayac" id="oynatmaSayac"></p>
      <div class="oynatma-liste" id="oynatmaListe"></div>
    </div>
    <div id="kirpma" class="kirpma" hidden>
      <div class="kirpma-ust"><p class="kirpma-baslik">Kırpılacak aralığı seçin</p><button class="metin-btn" id="kirpmaKapat" type="button">Kapat</button></div>
      <video class="kirpma-video" id="kirpmaVideo" controls playsinline preload="metadata"></video>
      <div class="kirpma-zaman"><span id="kirpBasEtiket">00:00</span><span id="kirpSecim">Seçim: 00:00</span><span id="kirpBitEtiket">00:00</span></div>
      <div class="kirpma-cizelge">
        <div class="kirpma-secili" id="kirpSecili"></div>
        <input id="kirpBas" type="range" min="0" max="1" step="0.1" value="0" aria-label="Başlangıç zamanı">
        <input id="kirpBit" type="range" min="0" max="1" step="0.1" value="1" aria-label="Bitiş zamanı">
      </div>
      <div class="kirpma-alanlar">
        <label>Başlangıç <input id="kirpBasMetin" type="text" inputmode="numeric" value="00:00"></label>
        <label>Bitiş <input id="kirpBitMetin" type="text" inputmode="numeric" value="00:00"></label>
      </div>
      <p class="kirpma-not">Klip seçtiğiniz kalitede MP4 olarak hazırlanır (en fazla 30 dakika).</p>
    </div>
    <div id="formatlar" class="formatlar" hidden></div>
    <%- include('reklam', { alan: 'reklam_sonuc', boyut: '468 × 60 · mobil 320 × 50', ekSinif: 'reklam-ince reklam-sonuc' }) %>
    <div id="topluSonuc" class="toplu-sonuc"></div>
  </div>
</div>
