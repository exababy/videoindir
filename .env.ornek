PORT=3000
OTURUM_SIRRI=BURAYA_GUCLU_BIR_ANAHTAR_YAZIN
NODE_ENV=production
SESSION_SECURE=false
GECICI_DOSYA_SURESI=3600000
TEMIZLIK_ARALIGI=1800000

# SEO: kanonik adres. www veya farklı alan adından gelen istekler
# KANONIK_ALAN_ZORLA=true ise 301 ile bu adrese yönlendirilir.
SITE_URL=https://mp3.net.tr
KANONIK_ALAN_ZORLA=false
ILETISIM_EPOSTA=iletisim@mp3.net.tr

# Instagram hikaye / öne çıkanlar için yt-dlp çerez dosyası (Netscape formatı).
# YTDLP_COOKIES=/opt/mp3nettr/instagram-cookies.txt
# Instagram profil fotoğrafı veri merkezi IP'lerinde oturum ister.
# INSTAGRAM_SESSIONID=

# Günlük müzik listesi (YouTube Türkiye günlük en popüler müzik videoları).
# MUZIK_LISTESI=0 ile kapatılır. Bölge kodu ve sayfa açılacak şarkı sayısı:
MUZIK_LISTESI=1
MUZIK_BOLGE=tr
MUZIK_LISTE_ADET=25
# IndexNow (Bing/Yandex hızlı dizinleme): rastgele 32 karakterlik bir anahtar.
# INDEXNOW_KEY=

# YouTube bulut sunucu IP'lerini "bot değilim" doğrulamasına alırsa:
# YTDLP_COOKIES=/opt/mp3nettr/youtube-cookies.txt
# YTDLP_PROXY=http://kullanici:sifre@host:port
# YTDLP_EXTRACTOR_ARGS=

# TikTok, bulut IP'lerini engellediğinde yedek kaynak (tikwm.com) kullanılır.
# Kapatmak için: TIKTOK_YEDEK=0
TIKTOK_YEDEK=1
